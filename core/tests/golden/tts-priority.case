# A TTS line is shown as soon as it arrives. ASR hearing the TTS voice
# during its estimated duration is dropped; ASR after it continues.
ticks 100 10000
at 1000 final "hey chat" start=200 end=1000 speaker=streamer
at 2000 tts "Welcome in, Sam!" duration=2500 speaker=Mika
at 4000 final "welcome in sam" start=2200 end=4000
at 5400 final "anyway" start=5000 end=5400 speaker=streamer
---
1000 "hey chat"
2000 "hey chat\n>> Welcome in, Sam!"
5400 ">> Welcome in, Sam!\n>> anyway"
9400 ""
stat suppressed.tts_active 1
